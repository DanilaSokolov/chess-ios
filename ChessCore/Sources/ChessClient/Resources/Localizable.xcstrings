    },
    "Signing in failed (%@)." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось войти (%@)."
          }
        }
      }
    },
    "Signing in with this login is locked after too many wrong passwords. Ask support to unlock it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вход по этому логину заблокирован после слишком многих неверных паролей. Обратитесь в поддержку, чтобы снять блокировку."
          }
        }
      }
    },
    "That does not look like an email address." : {
      "comment" : "Error message when the email address provided is not a valid email address.",
