        }
      }
    },
    "That move is not allowed" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Так ходить нельзя"
          }
        }
      }
    },
    "The app and the server do not understand each other — please update the app" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение и сервер не понимают друг друга — обновите приложение"
          }
        }
      }
    },
    "The code is wrong or no longer works. Ask for a new one." : {
      "comment" : "Text displayed when the code for a password reset is invalid or expired.",
