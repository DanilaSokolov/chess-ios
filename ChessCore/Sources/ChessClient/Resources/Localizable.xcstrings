          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Шах!"
          }
        }
      }
    },
    "A login is 3 to 32 Latin letters, digits, dots, dashes or underscores." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Логин — от 3 до 32 латинских букв, цифр, точек, дефисов или подчёркиваний."
          }
        }
      }
    },
    "Anonymous accounts have no password to reset." : {
