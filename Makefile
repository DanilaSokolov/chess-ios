SWIFT_PROTOBUF_VERSION := 1.39.0
TOOLS := .tools
PROTOC_GEN_SWIFT := $(TOOLS)/swift-protobuf/.build/release/protoc-gen-swift
GRPC_SWIFT_PROTOBUF_VERSION := 2.5.0
PROTOC_GEN_GRPC_SWIFT := $(TOOLS)/grpc-swift-protobuf/.build/release/protoc-gen-grpc-swift-2
DERIVED := .build/xcode

.PHONY: proto test test-live test-apple mac ios clean models format lint

## proto: regenerate Swift code from proto/ (messages and gRPC clients only; the app serves nothing).
##   proto/ is a copy: the source of truth is the chess-backend repository.
proto: $(PROTOC_GEN_SWIFT) $(PROTOC_GEN_GRPC_SWIFT)
	protoc -I proto \
		--plugin=protoc-gen-swift=$(PROTOC_GEN_SWIFT) \
		--swift_out=ChessCore/Sources/ChessProto \
		--swift_opt=Visibility=Public --swift_opt=FileNaming=DropPath \
		proto/chess/v1/chess.proto proto/chess/v1/game_info.proto proto/chess/auth/v1/auth.proto \
		proto/chess/history/v1/history.proto proto/grpc/health/v1/health.proto
	protoc -I proto \
		--plugin=protoc-gen-grpc-swift-2=$(PROTOC_GEN_GRPC_SWIFT) \
		--grpc-swift-2_out=ChessCore/Sources/ChessProto \
		--grpc-swift-2_opt=Visibility=Public,Server=false,Client=true,FileNaming=DropPath \
		proto/chess/v1/game_info.proto proto/chess/auth/v1/auth.proto proto/chess/history/v1/history.proto \
		proto/grpc/health/v1/health.proto

$(PROTOC_GEN_SWIFT):
	mkdir -p $(TOOLS)
	test -d $(TOOLS)/swift-protobuf || git clone -q --depth 1 --branch $(SWIFT_PROTOBUF_VERSION) \
		https://github.com/apple/swift-protobuf.git $(TOOLS)/swift-protobuf
	cd $(TOOLS)/swift-protobuf && swift build -c release --product protoc-gen-swift

$(PROTOC_GEN_GRPC_SWIFT):
	mkdir -p $(TOOLS)
	test -d $(TOOLS)/grpc-swift-protobuf || git clone -q --depth 1 --branch $(GRPC_SWIFT_PROTOBUF_VERSION) \
		https://github.com/grpc/grpc-swift-protobuf.git $(TOOLS)/grpc-swift-protobuf
	cd $(TOOLS)/grpc-swift-protobuf && swift build -c release --product protoc-gen-grpc-swift-2

test: test-apple

## test-live: the app's network layer against the running services (`make up` in chess-backend first).
test-live:
	cd ChessCore && CHESS_SERVER_URL=ws://localhost:8080/ws CHESS_AUTH_URL=http://localhost:8081 \
		CHESS_HISTORY_URL=http://localhost:8082 CHESS_MAILPIT_URL=http://localhost:8025 swift test --filter 'Live'

## Release mode keeps the perft tests fast.
test-apple:
	cd ChessCore && swift test -c release

# Hand-written Swift; ChessProto is generated by `make proto` and left alone.
SWIFT_SOURCES := ChessApp ChessCore/Sources/ChessCore ChessCore/Sources/ChessNet \
	ChessCore/Sources/ChessModels ChessCore/Sources/ChessClient ChessCore/Sources/export-pieces \
	ChessCore/Tests

## format: rewrite Swift sources in the project style (.swift-format)
format:
	swift format format --in-place --recursive $(SWIFT_SOURCES)

## lint: report Swift style problems without changing files
lint:
	swift format lint --strict --recursive $(SWIFT_SOURCES)

## models: write the generated 3D pieces to Models as USD files
models:
	cd ChessCore && swift run export-pieces ../Models

mac:
	xcodebuild -project Chess.xcodeproj -scheme Chess -destination 'platform=macOS' \
		-derivedDataPath $(DERIVED) build

ios:
	xcodebuild -project Chess.xcodeproj -scheme Chess -destination 'generic/platform=iOS Simulator' \
		-derivedDataPath $(DERIVED) build

clean:
	rm -rf .build ChessCore/.build
